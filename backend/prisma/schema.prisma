generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMINISTRADOR
  OFICINA
  VENTAS
  LOGISTICA
}

enum PaymentFrequency {
  SEMANAL
  MENSUAL
  QUINCENAL
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  DEDUCTED
  CANCELLED
}

enum PeriodStatus {
  OPEN
  PROCESSING
  CLOSED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum ItemType {
  EARNING
  DEDUCTION
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(OFICINA)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee?
}

model Employee {
  id              String           @id @default(uuid())
  dni             String           @unique
  firstName       String
  lastName        String
  email           String?          @unique
  phone           String?
  department      Role             // OFICINA, VENTAS, LOGISTICA, etc.
  position        String
  hireDate        DateTime         @default(now())
  status          EmployeeStatus   @default(ACTIVE)
  
  // Información de pago
  paymentFrequency PaymentFrequency @default(SEMANAL)
  workSchedule     String?          @default("LUNES_A_SABADO")
  expectedCheckInTime String?       @default("08:00") // Hora programada de entrada (ej: 08:00) para control de retrasos
  baseSalary       Decimal          @db.Decimal(10, 2)
  bankName         String?
  bankAccountNumber String?
  qrImageUrl       String?
  notes            String?
  workerPin        String?          // PIN cifrado personal del trabajador para consultar sueldos

  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  advances        Advance[]
  payrollRecords  PayrollRecord[]
  attendances     Attendance[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Advance {
  id          String        @id @default(uuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount      Decimal       @db.Decimal(10, 2)
  reason      String
  requestDate DateTime      @default(now())
  status      AdvanceStatus @default(PENDING)
  notes       String?
  paymentMethod String?     @default("EFECTIVO")

  payrollRecordId String?
  payrollRecord   PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PayrollPeriod {
  id          String           @id @default(uuid())
  code        String           @unique // Ej: SEM-2026-W35 o MES-2026-08
  name        String           // Ej: "Semana 35 (25 Ago - 31 Ago 2026)"
  frequency   PaymentFrequency
  startDate   DateTime
  endDate     DateTime
  year        Int
  periodNumber Int             // Semana del año (1-52) o Mes (1-12)
  status      PeriodStatus     @default(OPEN)

  records     PayrollRecord[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PayrollRecord {
  id              String        @id @default(uuid())
  periodId        String
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  baseSalary      Decimal       @db.Decimal(10, 2)
  workedDays      Int           @default(7) // 7 para semanal, 30 para mensual
  overtimeHours   Decimal       @default(0) @db.Decimal(5, 2)
  overtimeAmount  Decimal       @default(0) @db.Decimal(10, 2)
  bonusesAmount   Decimal       @default(0) @db.Decimal(10, 2)
  totalEarnings   Decimal       @db.Decimal(10, 2)

  advancesDeduction Decimal     @default(0) @db.Decimal(10, 2)
  otherDeductions   Decimal     @default(0) @db.Decimal(10, 2)
  totalDeductions   Decimal     @db.Decimal(10, 2)

  netAmount       Decimal       @db.Decimal(10, 2)
  status          PayrollStatus @default(DRAFT)
  paidAt          DateTime?
  paymentReference String?

  items           PayrollItem[]
  advances        Advance[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([periodId, employeeId])
}

model PayrollItem {
  id              String        @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  
  type            ItemType      // EARNING o DEDUCTION
  name            String        // "Sueldo Base", "Bono Puntualidad", "Adelanto", "Seguro"
  amount          Decimal       @db.Decimal(10, 2)

  createdAt       DateTime      @default(now())
}

model Attendance {
  id          String         @id @default(uuid())
  employeeId  String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        AttendanceType @default(CHECK_IN)
  timestamp   DateTime       @default(now())
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  deviceInfo  String?
  notes       String?

  createdAt   DateTime       @default(now())

  @@index([employeeId])
  @@index([timestamp])
}

